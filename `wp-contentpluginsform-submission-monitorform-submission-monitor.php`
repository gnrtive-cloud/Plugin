<?php
/**
 * Plugin Name: Form Submission Monitor
 * Description: Captures submission form entries and exposes an admin page to review them.
 * Version: 1.0.0
 * Author: AutoGenerated
 */

if (!defined('ABSPATH')) {
    exit;
}

class Form_Submission_Monitor {
    private const TABLE_NAME = 'business_form_submissions';
    private const OPTION_VERSION = 'form_submission_monitor_db_version';

    public function __construct() {
        register_activation_hook(__FILE__, [$this, 'activate']);
        add_action('rest_api_init', [$this, 'register_routes']);
        add_action('admin_menu', [$this, 'register_admin_page']);
        add_action('admin_enqueue_scripts', [$this, 'enqueue_admin_assets']);
        add_action('wp_enqueue_scripts', [$this, 'enqueue_public_assets']);
        add_shortcode('business_submission_form', [$this, 'render_form_shortcode']);
    }

    public function activate(): void {
        global $wpdb;
        $table_name = $this->get_table_name($wpdb);
        $charset_collate = $wpdb->get_charset_collate();

        $sql = "CREATE TABLE {$table_name} (
            id BIGINT(20) UNSIGNED NOT NULL AUTO_INCREMENT,
            name VARCHAR(191) NOT NULL,
            phone_number VARCHAR(32) NOT NULL,
            address VARCHAR(255) NOT NULL,
            asking_amount BIGINT(20) UNSIGNED NOT NULL,
            created_at DATETIME NOT NULL DEFAULT CURRENT_TIMESTAMP,
            PRIMARY KEY  (id)
        ) {$charset_collate};";

        require_once ABSPATH . 'wp-admin/includes/upgrade.php';
        dbDelta($sql);
        update_option(self::OPTION_VERSION, '1.0.0');
    }

    public function register_routes(): void {
        register_rest_route(
            'form-monitor/v1',
            '/submissions',
            [
                'methods'             => WP_REST_Server::CREATABLE,
                'callback'            => [$this, 'handle_submission'],
                'permission_callback' => '__return_true',
                'args'                => $this->get_submission_args(),
            ]
        );

        register_rest_route(
            'form-monitor/v1',
            '/submissions',
            [
                'methods'             => WP_REST_Server::READABLE,
                'callback'            => [$this, 'list_submissions'],
                'permission_callback' => [$this, 'ensure_manage_options'],
                'args'                => [
                    'page' => [
                        'default'           => 1,
                        'sanitize_callback' => 'absint',
                    ],
                ],
            ]
        );
    }

    private function get_submission_args(): array {
        return [
            'name' => [
                'required'          => true,
                'sanitize_callback' => 'sanitize_text_field',
            ],
            'phone_number' => [
                'required'          => true,
                'sanitize_callback' => 'sanitize_text_field',
            ],
            'address' => [
                'required'          => true,
                'sanitize_callback' => 'sanitize_text_field',
            ],
            'asking_amount' => [
                'required'          => true,
                'sanitize_callback' => 'absint',
                'validate_callback' => function ($value) {
                    return $value >= 0;
                },
            ],
        ];
    }

    public function handle_submission(WP_REST_Request $request): WP_REST_Response {
        global $wpdb;
        $table_name = $this->get_table_name($wpdb);

        $data = [
            'name'          => $request->get_param('name'),
            'phone_number'  => $request->get_param('phone_number'),
            'address'       => $request->get_param('address'),
            'asking_amount' => $request->get_param('asking_amount'),
        ];

        $inserted = $wpdb->insert($table_name, $data, ['%s', '%s', '%s', '%d']);

        if (false === $inserted) {
            return new WP_REST_Response(['message' => __('Unable to save submission.', 'form-submission-monitor')], 500);
        }

        return new WP_REST_Response([
            'message' => __('Submission received.', 'form-submission-monitor'),
        ], 201);
    }

    public function list_submissions(WP_REST_Request $request): WP_REST_Response {
        global $wpdb;
        $table_name = $this->get_table_name($wpdb);
        $per_page = 20;
        $page = max(1, (int) $request->get_param('page'));
        $offset = ($page - 1) * $per_page;

        $rows = $wpdb->get_results(
            $wpdb->prepare(
                "SELECT * FROM {$table_name} ORDER BY created_at DESC LIMIT %d OFFSET %d",
                $per_page,
                $offset
            ),
            ARRAY_A
        );

        $total = (int) $wpdb->get_var("SELECT COUNT(*) FROM {$table_name}");

        return new WP_REST_Response([
            'data'  => $rows,
            'total' => $total,
            'page'  => $page,
            'pages' => ceil($total / $per_page),
        ]);
    }

    public function register_admin_page(): void {
        add_menu_page(
            __('Form Submissions', 'form-submission-monitor'),
            __('Form Submissions', 'form-submission-monitor'),
            'manage_options',
            'form-submission-monitor',
            [$this, 'render_admin_page'],
            'dashicons-feedback',
            25
        );
    }

    public function enqueue_admin_assets(string $hook): void {
        if ('toplevel_page_form-submission-monitor' !== $hook) {
            return;
        }

        wp_enqueue_style(
            'form-submission-monitor-admin',
            plugins_url('assets/admin.css', __FILE__),
            [],
            '1.0.0'
        );
    }

    public function enqueue_public_assets(): void {
        wp_register_script(
            'form-submission-monitor',
            plugins_url('assets/js/form-submission.js', __FILE__),
            ['wp-api'],
            '1.0.0',
            true
        );

        wp_localize_script(
            'form-submission-monitor',
            'FormSubmissionMonitor',
            [
                'root'  => esc_url_raw(rest_url('form-monitor/v1/submissions')),
                'nonce' => wp_create_nonce('wp_rest'),
            ]
        );
    }

    public function render_form_shortcode(): string {
        wp_enqueue_script('form-submission-monitor');

        ob_start();
        ?>
        <form id="business-loan-form" class="business-loan-form">
            <label>Business Address <input type="text" name="address" required></label>
            <label>Phone Number <input type="tel" name="phone_number" required></label>
            <label>Contact Name <input type="text" name="name" required></label>
            <label>Asking Amount (USD) <input type="number" name="asking_amount" required min="0" step="1"></label>
            <button type="submit">Submit Review</button>
            <p class="submission-message" hidden></p>
        </form>
        <?php

        return (string) ob_get_clean();
    }

    public function render_admin_page(): void {
        if (!$this->ensure_manage_options()) {
            return;
        }

        global $wpdb;
        $table_name = $this->get_table_name($wpdb);
        $rows = $wpdb->get_results("SELECT * FROM {$table_name} ORDER BY created_at DESC", ARRAY_A);
        ?>
        <div class="wrap">
            <h1><?php esc_html_e('Form Submissions', 'form-submission-monitor'); ?></h1>
            <p><?php esc_html_e('Monitor submissions from the business loan form.', 'form-submission-monitor'); ?></p>
            <table class="widefat fixed striped">
                <thead>
                    <tr>
                        <th><?php esc_html_e('Name', 'form-submission-monitor'); ?></th>
                        <th><?php esc_html_e('Phone', 'form-submission-monitor'); ?></th>
                        <th><?php esc_html_e('Address', 'form-submission-monitor'); ?></th>
                        <th><?php esc_html_e('Asking Amount', 'form-submission-monitor'); ?></th>
                        <th><?php esc_html_e('Submitted', 'form-submission-monitor'); ?></th>
                    </tr>
                </thead>
                <tbody>
                <?php if (empty($rows)) : ?>
                    <tr>
                        <td colspan="5"><?php esc_html_e('No submissions yet.', 'form-submission-monitor'); ?></td>
                    </tr>
                <?php else : ?>
                    <?php foreach ($rows as $row) : ?>
                        <tr>
                            <td><?php echo esc_html($row['name']); ?></td>
                            <td><?php echo esc_html($row['phone_number']); ?></td>
                            <td><?php echo esc_html($row['address']); ?></td>
                            <td><?php echo esc_html(number_format_i18n($row['asking_amount'])); ?></td>
                            <td><?php echo esc_html(get_date_from_gmt($row['created_at'], get_option('date_format') . ' ' . get_option('time_format'))); ?></td>
                        </tr>
                    <?php endforeach; ?>
                <?php endif; ?>
                </tbody>
            </table>
        </div>
        <?php
    }

    private function ensure_manage_options(): bool {
        return current_user_can('manage_options');
    }

    private function get_table_name($wpdb): string {
        return $wpdb->prefix . self::TABLE_NAME;
    }
}

new Form_Submission_Monitor();
